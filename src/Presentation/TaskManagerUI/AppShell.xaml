<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TaskManagerUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TaskManagerUI"
    xmlns:page="clr-namespace:TaskManagerUI.Features.Pages"
    Shell.FlyoutBehavior="Disabled">
    <TabBar>
        <ShellContent
            Icon="{StaticResource IconHomePage}"
            Title="Home"
            ContentTemplate="{DataTemplate page:HomePage}"
            Route="HomePage" />
        <ShellContent
            Title="Calender"
            ContentTemplate="{DataTemplate page:CalenderPage}"
            Route="CalenderPage" />
        <ShellContent
            Title="Task"
            ContentTemplate="{DataTemplate page:TaskPage}"
            Route="TaskPage" />
        <ShellContent
            Title="Note"
            ContentTemplate="{DataTemplate page:NotePage}"
            Route="NotePage" />
        <ShellContent
            Title="Profile"
            ContentTemplate="{DataTemplate page:ProfilePage}"
            Route="ProfilePage" />
    </TabBar>
</Shell>
