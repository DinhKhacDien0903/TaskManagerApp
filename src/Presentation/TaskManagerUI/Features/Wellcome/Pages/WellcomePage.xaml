<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage
    x:Class="TaskManagerUI.Features.Pages.WellcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:TaskManagerUI.Utilities.MVVM"
    xmlns:pm="clr-namespace:TaskManagerUI.Features.PageModels"
    Title="WellcomePage"
    x:DataType="pm:WellcomePageModel"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <base:BasePage.Resources>

        <Color x:Key="WelcomeGradientStart">#E8F8F5</Color>
        <Color x:Key="WelcomeGradientEnd">#FFF8E1</Color>
        <Color x:Key="WelcomeTitleColor">#2D3748</Color>
        <Color x:Key="WelcomeDescriptionColor">#718096</Color>
        <Color x:Key="WelcomeButtonBackground">#5f33e1</Color>
        <Color x:Key="WelcomeButtonText">#FFFFFF</Color>

        <!--  Enhanced Shadow for 3D Bulge Effect  -->
        <Shadow
            x:Key="Button3DShadow"
            Brush="#40000000"
            Opacity="0.2"
            Radius="50"
            Offset="0,4" />

        <Style x:Key="WelcomeTitleStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansBold" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="TextColor" Value="{StaticResource WelcomeTitleColor}" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style x:Key="WelcomeDescriptionStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="{StaticResource WelcomeDescriptionColor}" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
            <Setter Property="Margin" Value="20,10,20,0" />
        </Style>

