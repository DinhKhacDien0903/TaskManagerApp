        <Style x:Key="WelcomeImageStyle" TargetType="Image">
            <Setter Property="Aspect" Value="AspectFill" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="MaximumHeightRequest" Value="540" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>
    </base:BasePage.Resources>
    <base:BasePage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0.0" Color="{StaticResource WelcomeGradientStart}" />
            <GradientStop Offset="1.0" Color="{StaticResource WelcomeGradientEnd}" />
        </LinearGradientBrush>
    </base:BasePage.Background>
    <ScrollView>
        <Grid
            Margin="0"
            Padding="0,0,0,20"
            RowDefinitions="*,10,Auto,10,Auto,10,Auto">
            <Image
                Grid.Row="0"
                Source="temp_image.png"
                Style="{StaticResource WelcomeImageStyle}" />
            <Label
                Grid.Row="2"
                Margin="20,0,20,15"
                Style="{StaticResource WelcomeTitleStyle}"
                Text="Task Management &amp;&#10;To-Do List" />
            <Label
                Grid.Row="4"
                Margin="30,0,30,30"
                Style="{StaticResource WelcomeDescriptionStyle}"
                Text="This productive tool is designed to help you better manage your task project-wise conveniently!" />
            <Button
                Grid.Row="6"
                Command="{Binding OpenHomePageCommand}"
                HorizontalOptions="FillAndExpand"
                Text="Let's Start ➤"
                VerticalOptions="Start" />
        </Grid>
    </ScrollView>
</base:BasePage>