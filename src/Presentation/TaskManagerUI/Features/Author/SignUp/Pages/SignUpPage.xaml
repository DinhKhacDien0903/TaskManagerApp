<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               x:Class="TaskManagerUI.Features.Pages.SignUpPage"
               xmlns:base="clr-namespace:TaskManagerUI.Utilities.MVVM"
               xmlns:pm="clr-namespace:TaskManagerUI.Features.PageModels"
               x:DataType="pm:SignUpPageModel"
               Title="SignUpPage">
       <ScrollView
              Padding="30">
              <!-- <Entry Placeholder="Email"
                     Text="{Binding Email}"/>
              <Entry Placeholder="Password"
                     IsPassword="True"
                     Text="{Binding Password}"/>
              <Entry Placeholder="Confirm Password"
                     IsPassword="True"
                     Text="{Binding ConfirmPassword}"/>
              <Label Text="{Binding ErrorMessage}"
                     TextColor="Red"/>
              <Button Text="Login"
                      Command="{Binding SignUpCommand}"/> -->

              <Grid RowDefinitions="Auto, *"
                    IgnoreSafeArea="True">

                     <!-- Decorative Background Circle -->
                     <BoxView Grid.Row="0"
                              Color="#A0E0D0"
                              HeightRequest="200"
                              WidthRequest="200"
                              CornerRadius="100"
                              VerticalOptions="Start"
                              HorizontalOptions="Start"
                              Margin="-50,-80,0,0"/>

                     <!-- Main Content Layout -->
                     <ScrollView Grid.Row="0"
                                 Grid.RowSpan="2">
                            <VerticalStackLayout Spacing="15"
                                                 Padding="30,0"
                                                 VerticalOptions="Center">

                                   <!-- Header Text -->
                                   <Label Text="Welcome Onboard!"
                                          FontSize="32"
                                          FontAttributes="Bold"
                                          TextColor="#333333"
                                          HorizontalOptions="Center"
                                          Margin="0,100,0,0"/>

                                   <Label Text="Lets help you in completing your tasks"
                                          FontSize="16"
                                          TextColor="#666666"
                                          HorizontalOptions="Center"
                                          Margin="0,0,0,30"/>

                                   <!-- Full Name Input -->
                                   <Label Text="Full name"
                                          TextColor="#333333"
                                          FontAttributes="Bold"/>
                                   <Border StrokeShape="RoundRectangle 15"
                                           BackgroundColor="White"
                                           Stroke="Transparent"
                                           Padding="15,0"
                                           HeightRequest="50">
                                          <Border.Shadow>
                                                 <Shadow Brush="Black"
                                                         Offset="5,5"
                                                         Radius="15"
                                                         Opacity="0.1"/>
                                          </Border.Shadow>
                                          <Entry Placeholder="Mary Elliot"
                                                 TextColor="#333333"
                                                 BackgroundColor="Transparent"
                                                 VerticalOptions="Center"/>
                                   </Border>

                                   <!-- Email Input -->
                                   <Label Text="Email"
                                          TextColor="#333333"
                                          FontAttributes="Bold"/>
                                   <Border StrokeShape="RoundRectangle 15"
                                           BackgroundColor="White"
                                           Stroke="Transparent"
                                           Padding="15,0"
                                           HeightRequest="50">
                                          <Border.Shadow>
                                                 <Shadow Brush="Black"
                                                         Offset="5,5"
                                                         Radius="15"
                                                         Opacity="0.1"/>
                                          </Border.Shadow>
                                          <Entry Placeholder="mary.elliot@mail.com"
                                                 Keyboard="Email"
                                                 Text="{Binding Email}"
                                                 TextColor="#333333"
                                                 BackgroundColor="Transparent"
                                                 VerticalOptions="Center"/>
                                   </Border>

                                   <!-- Password Input -->
                                   <Label Text="Password"
                                          TextColor="#333333"
                                          FontAttributes="Bold"/>
                                   <Border StrokeShape="RoundRectangle 15"
                                           BackgroundColor="White"
                                           Stroke="Transparent"
                                           Padding="15,0"
                                           HeightRequest="50">
                                          <Border.Shadow>
                                                 <Shadow Brush="Black"
                                                         Offset="5,5"
                                                         Radius="15"
                                                         Opacity="0.1"/>
                                          </Border.Shadow>
                                          <Entry
                                                 Placeholder="************"
                                                 IsPassword="True"
                                                 Text="{Binding Password}"
                                                 TextColor="#333333"
                                                 BackgroundColor="Transparent"
                                                 VerticalOptions="Center"/>
                                   </Border>

                                   <!-- Confirm Password Input -->
                                   <Label Text="Confirm Password"
                                          TextColor="#333333"
                                          FontAttributes="Bold"/>
                                   <Border StrokeShape="RoundRectangle 15"
                                           BackgroundColor="White"
                                           Stroke="Transparent"
                                           Padding="15,0"
                                           HeightRequest="50">
                                          <Border.Shadow>
                                                 <Shadow Brush="Black"
                                                         Offset="5,5"
                                                         Radius="15"
                                                         Opacity="0.1"/>
                                          </Border.Shadow>
                                          <Entry               IsPassword="True"
                                                               Text="{Binding ConfirmPassword}"
                                                               Placeholder="************"
                                                               TextColor="#333333"
                                                               BackgroundColor="Transparent"
                                                               VerticalOptions="Center"/>
                                   </Border>

                                   <!-- Register Button -->
                                   <Button Text="Register"
                                           TextColor="White"
                                           BackgroundColor="#48C9A9"
                                           CornerRadius="25"
                                           Command="{Binding SignUpCommand}"
                                           HeightRequest="50"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           Margin="0,20,0,0"/>

                                   <!-- Sign In Link -->
                                   <HorizontalStackLayout HorizontalOptions="Center"
                                                          Spacing="5"
                                                          Margin="0,10,0,0">
                                          <Label Text="Already have an account?"
                                                 TextColor="#666666"
                                                 VerticalOptions="Center"/>
                                          <Label Text="Sign In"
                                                 TextColor="#48C9A9"
                                                 FontAttributes="Bold"
                                                 VerticalOptions="Center">
                                                 <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnSignInTapped"/>
                                                 </Label.GestureRecognizers>
                                          </Label>
                                   </HorizontalStackLayout>

                            </VerticalStackLayout>
                     </ScrollView>
              </Grid>
       </ScrollView>
</base:BasePage>