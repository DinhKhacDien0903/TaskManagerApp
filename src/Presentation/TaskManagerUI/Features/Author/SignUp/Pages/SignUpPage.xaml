<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage
    x:Class="TaskManagerUI.Features.Pages.SignUpPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:TaskManagerUI.Utilities.MVVM"
    xmlns:controls="clr-namespace:TaskManagerUI.UI.Controls"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:pm="clr-namespace:TaskManagerUI.Features.PageModels"
    Title="SignUpPage"
    x:DataType="pm:SignUpPageModel"
    BackgroundColor="#F8F9FA"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <base:BasePage.Resources>
        <Color x:Key="PrimaryColor">#5f33e1</Color>
        <Color x:Key="BackgroundColor">#F8F9FA</Color>
        <Color x:Key="SurfaceColor">White</Color>
        <Color x:Key="BorderColor">#E2E8F0</Color>
        <Color x:Key="TextPrimaryColor">#2D3748</Color>
        <Color x:Key="TextSecondaryColor">#4A5568</Color>
        <Color x:Key="TextTertiaryColor">#718096</Color>
        <Color x:Key="PlaceholderColor">#A0AEC0</Color>
        <Color x:Key="ErrorColor">#E53E3E</Color>

        <!--  Font Size Resources  -->
        <x:Double x:Key="TitleFontSize">28</x:Double>
        <x:Double x:Key="LargeFontSize">16</x:Double>
        <x:Double x:Key="MediumFontSize">14</x:Double>

        <!--  Base Styles  -->
        <Style x:Key="BaseLabelStyle" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <!--  Inherited Styles  -->
        <Style
            x:Key="TitleLabelStyle"
            BasedOn="{StaticResource BaseLabelStyle}"
            TargetType="Label">
            <Setter Property="FontSize" Value="{StaticResource TitleFontSize}" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
        </Style>

        <Style x:Key="SubtitleLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="{StaticResource LargeFontSize}" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="TextColor" Value="{StaticResource TextTertiaryColor}" />
        </Style>

        <Style
            x:Key="FieldLabelStyle"
            BasedOn="{StaticResource BaseLabelStyle}"
            TargetType="Label">
            <Setter Property="FontSize" Value="{StaticResource MediumFontSize}" />
            <Setter Property="TextColor" Value="{StaticResource TextSecondaryColor}" />
        </Style>

        <Style
            x:Key="LinkLabelStyle"
            BasedOn="{StaticResource BaseLabelStyle}"
            TargetType="Label">
            <Setter Property="FontSize" Value="{StaticResource MediumFontSize}" />
            <Setter Property="TextColor" Value="{StaticResource PrimaryColor}" />
        </Style>

        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
            <Setter Property="Stroke" Value="{StaticResource BorderColor}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        </Style>

        <Style x:Key="InputEntryStyle" TargetType="Entry">
            <Setter Property="Margin" Value="10,5" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="{StaticResource LargeFontSize}" />
            <Setter Property="PlaceholderColor" Value="{StaticResource PlaceholderColor}" />
            <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="{StaticResource LargeFontSize}" />
            <Setter Property="HeightRequest" Value="50" />
            <Setter Property="TextColor" Value="White" />
        </Style>
    </base:BasePage.Resources>

    <ScrollView VerticalScrollBarVisibility="Never">
        <Grid Padding="20" RowDefinitions="Auto,*,Auto">

            <!--  Header Section  -->
            <StackLayout
                Grid.Row="0"
                Spacing="20"
                VerticalOptions="Start">

                <Label
                    Margin="0,20,0,0"
                    Style="{StaticResource TitleLabelStyle}"
                    Text="Welcome Onboard!" />

                <Label Style="{StaticResource SubtitleLabelStyle}" Text="Let's help you in completing your tasks" />

                <ffimageloading:CachedImage
                    Margin="0,20,0,0"
                    Aspect="AspectFill"
                    DownsampleToViewSize="False"
                    HeightRequest="200"
                    IsOpaque="True"
                    LoadingPriority="Highest"
                    Source="logo_app.jpeg"
                    WidthRequest="200">
                    <ffimageloading:CachedImage.Clip>
                        <RoundRectangleGeometry CornerRadius="100" Rect="0,0,200,200" />
                    </ffimageloading:CachedImage.Clip>
                </ffimageloading:CachedImage>
            </StackLayout>

            <!--  Form Section  -->
            <StackLayout
                Grid.Row="1"
                Margin="0,5"
                Spacing="10"
                VerticalOptions="Center">

                <!--  Full Name Field  -->
                <StackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabelStyle}" Text="Full Name" />
                    <Border Style="{StaticResource InputBorderStyle}">
                        <controls:BorderlessEntry
                            Placeholder="Mary Elliot"
                            Style="{StaticResource InputEntryStyle}"
                            Text="{Binding FullName}" />
                    </Border>
                </StackLayout>

                <!--  Email Field  -->
                <StackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabelStyle}" Text="Email" />
                    <Border Style="{StaticResource InputBorderStyle}">
                        <controls:BorderlessEntry
                            Keyboard="Email"
                            Placeholder="mary.elliot@mail.com"
                            Style="{StaticResource InputEntryStyle}"
                            Text="{Binding Email}" />
                    </Border>
                </StackLayout>

                <!--  Password Field  -->
                <StackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabelStyle}" Text="Password" />
                    <Border Style="{StaticResource InputBorderStyle}">
                        <controls:BorderlessEntry
                            IsPassword="True"
                            Placeholder="••••••••••••"
                            Style="{StaticResource InputEntryStyle}"
                            Text="{Binding Password}" />
                    </Border>
                </StackLayout>

                <!--  Confirm Password Field  -->
                <StackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabelStyle}" Text="Confirm Password" />
                    <Border Style="{StaticResource InputBorderStyle}">
                        <controls:BorderlessEntry
                            IsPassword="True"
                            Placeholder="••••••••••••"
                            Style="{StaticResource InputEntryStyle}"
                            Text="{Binding ConfirmPassword}" />
                    </Border>
                </StackLayout>

                <!--  Error Message  -->
                <Label
                    Margin="0,10,0,0"
                    FontSize="14"
                    HorizontalOptions="Center"
                    IsVisible="{Binding HasError}"
                    Text="{Binding ErrorMessage}"
                    TextColor="{StaticResource ErrorColor}" />
            </StackLayout>

            <!--  Bottom Section  -->
            <StackLayout
                Grid.Row="2"
                Spacing="20"
                VerticalOptions="End">

                <!--  Register Button  -->
                <Button
                    Margin="0,10,0,0"
                    Command="{Binding SignUpCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="Register" />

                <!--  Sign In Link  -->
                <StackLayout
                    HorizontalOptions="Center"
                    Orientation="Horizontal"
                    Spacing="5">
                    <Label
                        FontSize="14"
                        Text="Already have an account?"
                        TextColor="{StaticResource TextTertiaryColor}" />
                    <Label Style="{StaticResource LinkLabelStyle}" Text="Sign In">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToSignInCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </StackLayout>
            </StackLayout>
        </Grid>
    </ScrollView>
</base:BasePage>